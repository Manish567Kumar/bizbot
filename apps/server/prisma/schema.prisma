generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Industry {
  RESTAURANT
  SALON
  CLINIC
  TUITION
  SHOP
  OTHER
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  PRO
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

enum ConversationStatus {
  OPEN
  RESOLVED
  BOT
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  INTERACTIVE
  TEMPLATE
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Business {
  id              String   @id @default(uuid())
  name            String
  phone           String   @unique  // Registered WhatsApp Business phone
  wabaId          String?           // WhatsApp Business Account ID
  waPhoneNumberId String?           // WhatsApp Phone Number ID (for sending)
  industry        Industry @default(OTHER)
  planTier        PlanTier @default(FREE)
  isActive        Boolean  @default(true)
  settings        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users         User[]
  customers     Customer[]
  conversations Conversation[]
  botFlows      BotFlow[]
  analytics     Analytics[]

  @@map("businesses")
}

model User {
  id           String    @id @default(uuid())
  businessId   String
  phone        String
  name         String?
  role         UserRole  @default(OWNER)
  refreshToken String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phone])
  @@map("users")
}

model OtpRecord {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@map("otp_records")
}

model Customer {
  id         String    @id @default(uuid())
  businessId String
  phone      String    // WhatsApp number (with country code)
  name       String?
  tags       String[]  @default([])
  metadata   Json      @default("{}")
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([businessId, phone])
  @@index([businessId, createdAt])
  @@map("customers")
}

model Conversation {
  id            String             @id @default(uuid())
  businessId    String
  customerId    String
  status        ConversationStatus @default(OPEN)
  botEnabled    Boolean            @default(true)
  lastMessageAt DateTime?
  metadata      Json               @default("{}")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([businessId, status])
  @@index([businessId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  waMessageId    String?       @unique  // Meta's message ID
  direction      Direction
  type           MessageType   @default(TEXT)
  content        String
  status         MessageStatus @default(SENT)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model BotFlow {
  id         String   @id @default(uuid())
  businessId String
  name       String
  isActive   Boolean  @default(true)
  priority   Int      @default(0)
  /// { type: 'keyword'|'greeting'|'after_hours'|'default', patterns?: string[], startHour?: number, endHour?: number }
  trigger    Json
  /// { type: 'text'|'quick_reply', message: string, buttons?: Array<{id: string, title: string}> }
  response   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isActive, priority])
  @@map("bot_flows")
}

model Analytics {
  id                    String   @id @default(uuid())
  businessId            String
  date                  DateTime @db.Date
  totalMessages         Int      @default(0)
  inboundMessages       Int      @default(0)
  outboundMessages      Int      @default(0)
  botReplies            Int      @default(0)
  newCustomers          Int      @default(0)
  openConversations     Int      @default(0)
  resolvedConversations Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@map("analytics")
}
