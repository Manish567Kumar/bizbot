# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bizbot:password@localhost:5432/bizbot

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── MSG91 (OTP) ──────────────────────────────────────────────────────────────
# Get from https://msg91.com
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_otp_template_id
MSG91_SENDER_ID=BIZBOTAPP

# ─── Meta / WhatsApp Business API ─────────────────────────────────────────────
# https://developers.facebook.com/apps/
META_VERIFY_TOKEN=your-random-verify-token
META_APP_SECRET=your-meta-app-secret
META_API_VERSION=v18.0
META_ACCESS_TOKEN=your-permanent-page-access-token
